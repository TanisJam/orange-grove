{
  "schema_version": 2,
  "features": [],
  "statuses": [
    "seed",
    "exploring",
    "rooting",
    "shaping",
    "pruning",
    "spec_ready",
    "growing",
    "ripening",
    "harvest_ready",
    "done",
    "archived"
  ],
  "kinds": ["feature", "change"],
  "rules": {
    "only_one_active_feature": true,
    "human_approval_required_before_growing": true,
    "ripening_required_before_harvest": true,
    "change_requires_targets": true
  },
  "_schema_docs": {
    "feature_entry": {
      "id": "string — unique. For changes use '<base>/<change-id>'.",
      "kind": "'feature' | 'change' — defaults to 'feature' if omitted",
      "targets": "<base-feature-id> — REQUIRED when kind == 'change'",
      "status": "one of statuses[]",
      "name": "human-readable label",
      "summary": "one-paragraph description",
      "notes": "optional list of strings"
    }
  }
}
